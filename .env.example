DATABASE_URL="postgresql://user:password@localhost:5432/financeops?schema=public"

# Segredo usado para hash dos tokens de sessão (gerar com: openssl rand -hex 32)
SESSION_SECRET="troque-por-um-valor-aleatorio-de-64-caracteres-hex"

# Ambiente
NODE_ENV="development"

# Usuário inicial usado apenas pelo comando de seed
SEED_ADMIN_EMAIL="admin@financeops.local"
SEED_ADMIN_PASSWORD="troque-esta-senha-antes-de-publicar"

# Integração com WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Observabilidade
LOG_LEVEL="info"
