# Aplicação: use a conexão com pool no ambiente publicado.
DATABASE_URL="postgresql://user:password@ep-example-pooler.sa-east-1.aws.neon.tech/financeops?sslmode=require"

# Migrações: use a conexão direta do mesmo banco.
DIRECT_URL="postgresql://user:password@ep-example.sa-east-1.aws.neon.tech/financeops?sslmode=require"

# Segredo usado para hash dos tokens de sessão (gerar com: openssl rand -hex 32)
SESSION_SECRET="troque-por-um-valor-aleatorio-de-64-caracteres-hex"

# Ambiente
NODE_ENV="development"

# Usuário inicial usado apenas pelo comando de seed
SEED_ADMIN_NAME="Seu nome"
SEED_ADMIN_EMAIL="voce@exemplo.com"
SEED_ADMIN_PASSWORD="use-uma-senha-unica-com-12-ou-mais-caracteres"

# Integração com WhatsApp Business API
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Observabilidade
LOG_LEVEL="info"
